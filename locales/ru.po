msgstr "GNOME Software перестаёт загружать обновления в фоне."

msgid "Disable external search providers"
msgstr "Отключить внешние поставщики поиска"

msgid "Overview search only shows local results."
msgstr "Поиск в обзоре показывает только локальные результаты."

msgid "Use a fixed number of workspaces"
msgstr "Фиксированное число рабочих столов"

msgid "Show taskbar thumbnails faster"
msgstr "Быстрее показывать эскизы на панели задач"

msgid "Hovering over a taskbar button shows window thumbnails with almost no delay."
msgstr "При наведении на кнопку панели задач эскизы окон появляются почти без задержки."

msgid "Show Peek at desktop faster"
msgstr "Быстрее показывать просмотр рабочего стола"

msgid "Shorter delay before the desktop preview appears when hovering the corner of the taskbar."
msgstr "Меньшая задержка перед предпросмотром рабочего стола при наведении на угол панели задач."

msgid "Speed up Windows menus"
msgstr "Ускорить меню Windows"

msgid "Minimizes the delay before a submenu opens (default 400 ms)."
msgstr "Сокращает задержку перед открытием подменю (по умолчанию 400 мс)."

msgid "Use the Windows 10 context menu"
msgstr "Использовать контекстное меню Windows 10"

msgid "Opens the full classic right-click menu directly instead of the Windows 11 compact menu."
msgstr "Сразу открывает полное классическое контекстное меню вместо компактного меню Windows 11."

msgid "Disable ads and suggested apps"
msgstr "Отключить рекламу и предлагаемые приложения"

msgid "Stops Start suggestions, silently installed promoted apps, tips and sync-provider ads in File Explorer."
msgstr "Отключает предложения в «Пуске», тихо устанавливаемые приложения, советы и рекламу синхронизации в Проводнике."

msgid "Disable blur on the sign-in screen"
msgstr "Отключить размытие на экране входа"

msgid "Shows the sign-in background image sharp instead of blurred."
msgstr "Фон экрана входа отображается чётким, а не размытым."

msgid "Use the classic battery indicator"
msgstr "Классический индикатор батареи"

msgid "Replaces the modern battery flyout with the Windows 7 style one."
msgstr "Заменяет современное окно батареи окном в стиле Windows 7."

msgid "Show estimated battery time remaining"
msgstr "Показывать оставшееся время работы батареи"

msgid "Shows remaining battery time in the battery tooltip and flyout."
msgstr "Показывает оставшееся время в подсказке и окне батареи."

msgid "Disable Widgets"
msgstr "Отключить виджеты"

msgid "Removes the Widgets board and its taskbar button."
msgstr "Удаляет панель виджетов и её кнопку на панели задач."

msgid "Remove the shortcut arrow overlay"
msgstr "Убрать стрелку с ярлыков"

msgid "Hides the small arrow drawn on shortcut icons."
msgstr "Скрывает маленькую стрелку на значках ярлыков."

msgid "Disable Peek at desktop"
msgstr "Отключить просмотр рабочего стола"

msgid "Turns off the desktop preview when hovering the end of the taskbar."
msgstr "Отключает предпросмотр рабочего стола при наведении на край панели задач."

msgid "Use the classic volume control"
msgstr "Классический регулятор громкости"

msgid "Shows the Windows 7 style volume slider from the tray icon."
msgstr "Показывает регулятор громкости в стиле Windows 7 из значка в трее."

msgid "Disable \"You have new apps that can open this type of file\""
msgstr "Отключить «У вас есть новые приложения, которые могут открывать этот тип файлов»"

msgid "Stops the prompt that appears after installing an app that handles a file type."
msgstr "Убирает запрос после установки приложения, работающего с типом файлов."

msgid "Add \"Command Prompt as Administrator\" to the folder context menu"
msgstr "Добавить «Командная строка (администратор)» в контекстное меню папок"

msgid "Right-click the background of a folder to open an elevated command prompt there."
msgstr "Правый щелчок по фону папки открывает в ней командную строку с правами администратора."

msgid "Check \"Do this for all current items\" by default"
msgstr "Отмечать «Выполнить для всех текущих элементов» по умолчанию"

msgid "Pre-checks the box in the file conflict dialog."
msgstr "Заранее отмечает флажок в окне конфликта файлов."

msgid "Enable inline AutoComplete"
msgstr "Включить встроенное автозаполнение"

msgid "Completes typed text in the address bar, Run dialog and Open/Save dialogs."
msgstr "Дополняет текст в адресной строке, окне «Выполнить» и диалогах открытия/сохранения."

msgid "Open File Explorer to"
msgstr "Открывать Проводник в"

msgid "Choose the folder a new File Explorer window starts in."
msgstr "Выберите папку, в которой открывается новое окно Проводника."

msgid "This PC"
msgstr "Этот компьютер"

msgid "Quick access / Home"
msgstr "Быстрый доступ / Главная"

msgid "Downloads"
msgstr "Загрузки"

msgid "Disable pop-up descriptions"
msgstr "Отключить всплывающие описания"

msgid "Hides the tooltip shown when hovering over files and folders."
msgstr "Скрывает подсказку при наведении на файлы и папки."

msgid "Show drive letters first"
msgstr "Показывать букву диска первой"

msgid "Shows \"(C:) Local Disk\" instead of \"Local Disk (C:)\"."
msgstr "Показывает «(C:) Локальный диск» вместо «Локальный диск (C:)»."

msgid "Show full details in file operation dialogs"
msgstr "Показывать подробности в окнах операций с файлами"

msgid "Copy, move and delete dialogs open with \"More details\" expanded."
msgstr "Окна копирования, перемещения и удаления открываются с развёрнутыми «Подробностями»."

msgid "Add Rotate left/right to the image context menu"
msgstr "Добавить поворот влево/вправо в контекстное меню изображений"

msgid "Adds rotate commands for JPEG, PNG and BMP files."
msgstr "Добавляет команды поворота для файлов JPEG, PNG и BMP."

msgid "Use the classic File Explorer ribbon"
msgstr "Использовать классическую ленту Проводника"

msgid "Restores the Windows 10 tabbed ribbon. Works on early Windows 11 releases only."
msgstr "Возвращает ленту с вкладками Windows 10. Работает только в ранних версиях Windows 11."

msgid "Don't add \"- Shortcut\" to new shortcuts"
msgstr "Не добавлять «- ярлык» к новым ярлыкам"

msgid "New shortcuts keep the original name."
msgstr "Новые ярлыки сохраняют исходное имя."

msgid "Speed up mouse hover"
msgstr "Ускорить реакцию на наведение"

msgid "Tooltips and hover previews appear faster (default 400 ms)."
msgstr "Подсказки и превью при наведении появляются быстрее (по умолчанию 400 мс)."

msgid "Increase the icon cache"
msgstr "Увеличить кэш значков"

msgid "Lets Windows keep more icons in memory, so folders and the desktop load faster."
msgstr "Windows хранит больше значков в памяти, и папки с рабочим столом загружаются быстрее."

msgid "Disable Bing in taskbar search"
msgstr "Отключить Bing в поиске на панели задач"

msgid "Search on the taskbar only looks at your PC, not the web."
msgstr "Поиск на панели задач ищет только на компьютере, не в интернете."

msgid "Add \"End task\" to the taskbar menu"
msgstr "Добавить «Завершить задачу» в меню панели задач"

msgid "Right-click a taskbar button to force-close the app."
msgstr "Правый щелчок по кнопке на панели задач принудительно закрывает приложение."

msgid "Align taskbar buttons to the left"
msgstr "Выровнять кнопки панели задач по левому краю"

msgid "Moves the centered Windows 11 taskbar icons to the left."
msgstr "Перемещает центрированные значки панели задач Windows 11 влево."

msgid "Show seconds in the taskbar clock"
msgstr "Показывать секунды в часах панели задач"

msgid "Show the Windows version on the desktop"
msgstr "Показывать версию Windows на рабочем столе"

msgid "Draws the Windows edition and build in the lower-right corner."
msgstr "Показывает выпуск и сборку Windows в правом нижнем углу."

msgid "Disable AutoPlay on all drives"
msgstr "Отключить автозапуск на всех дисках"

msgid "Close unresponsive apps automatically"
msgstr "Автоматически закрывать зависшие приложения"

msgid "Ends hung apps faster and skips the \"This app is preventing shutdown\" screen."
msgstr "Быстрее завершает зависшие приложения и пропускает экран «Это приложение препятствует завершению работы»."

msgid "Never end apps automatically at shutdown"
msgstr "Никогда не закрывать приложения автоматически при выключении"

msgid "Windows waits for you instead of closing apps with unsaved work."
msgstr "Windows ждёт вас, а не закрывает приложения с несохранённой работой."

msgid "Disable the security warning on downloaded files"
msgstr "Отключить предупреждение безопасности для загруженных файлов"

msgid "Downloaded files are no longer marked as coming from the internet."
msgstr "Загруженные файлы больше не помечаются как полученные из интернета."

msgid "Add \"Take Ownership\" to the context menu"
msgstr "Добавить «Стать владельцем» в контекстное меню"

msgid "Right-click a file or folder to give Administrators full access to it."
msgstr "Правый щелчок по файлу или папке даёт администраторам полный доступ."

msgid "Disable SmartScreen"
msgstr "Отключить SmartScreen"

msgid "Turns off SmartScreen checks for apps and files."
msgstr "Отключает проверки SmartScreen для приложений и файлов."

msgid "Show details on blue screens"
msgstr "Показывать подробности на синем экране"

msgid "Shows the classic stop-error details instead of the sad face."
msgstr "Показывает классические сведения об ошибке вместо грустного смайлика."

msgid "Let elevated apps see mapped network drives"
msgstr "Разрешить приложениям с правами администратора видеть сетевые диски"

msgid "Apps run as administrator can access drives mapped by your normal session."
msgstr "Приложения, запущенные от администратора, видят диски, подключённые в обычном сеансе."

msgid "Disable User Account Control (UAC)"
msgstr "Отключить контроль учётных записей (UAC)"

msgid "Every app runs with full administrator rights and no prompt."
msgstr "Все приложения работают с полными правами администратора без запроса."

msgid "Block potentially unwanted apps (adware) in Defender"
msgstr "Блокировать потенциально нежелательные приложения (рекламное ПО) в Defender"

msgid "Make USB storage read-only"
msgstr "Сделать USB-накопители только для чтения"

msgid "Nothing can be written to USB mass storage devices."
msgstr "На USB-накопители ничего нельзя записать."

msgid "Notify when the camera turns on or off"
msgstr "Уведомлять о включении и выключении камеры"

msgid "Save a crash dump when a program crashes"
msgstr "Сохранять дамп при сбое программы"

msgid "Writes full dumps to %LOCALAPPDATA%\\CrashDumps (keeps the last 10)."
msgstr "Записывает полные дампы в %LOCALAPPDATA%\\CrashDumps (хранит 10 последних)."

msgid "Allow Windows 11 upgrade on unsupported hardware"
msgstr "Разрешить обновление до Windows 11 на неподдерживаемом оборудовании"

msgid "Lets the Windows 11 installer skip the TPM 2.0 and CPU checks."
msgstr "Позволяет установщику Windows 11 пропустить проверки TPM 2.0 и процессора."

msgid "Enable Windows Photo Viewer"
msgstr "Включить средство просмотра фотографий Windows"

msgid "Makes the classic Photo Viewer available in \"Open with\" for common image types."
msgstr "Делает классическое средство просмотра доступным в «Открыть с помощью» для обычных изображений."

msgid "Disable background apps"
msgstr "Отключить фоновые приложения"

msgid "Store apps can't run in the background, which saves power."
msgstr "Приложения Store не работают в фоне, что экономит энергию."

msgid "Add classic User Accounts to Control Panel"
msgstr "Добавить классические учётные записи пользователей в панель управления"

msgid "Adds an entry that opens the advanced user accounts dialog (netplwiz)."
msgstr "Добавляет пункт, открывающий расширенное окно учётных записей (netplwiz)."

msgid "Use classic Alt+Tab"
msgstr "Классический Alt+Tab"

msgid "Small icons instead of large window previews."
msgstr "Маленькие значки вместо больших превью окон."

msgid "Disable driver updates via Windows Update"
msgstr "Отключить обновление драйверов через Windows Update"

msgid "Disable automatic Store app updates"
msgstr "Отключить автообновление приложений Store"

msgid "Disable power throttling"
msgstr "Отключить ограничение мощности"

msgid "Background apps keep full CPU speed. Uses more battery."
msgstr "Фоновые приложения сохраняют полную скорость ЦП. Расходует больше заряда."

msgid "Minimize telemetry and data collection"
msgstr "Свести к минимуму телеметрию и сбор данных"

msgid "Sets diagnostic data to the lowest level the edition allows."
msgstr "Устанавливает самый низкий уровень диагностических данных, разрешённый выпуском."

msgid "Stop Microsoft Edge running in the background"
msgstr "Запретить работу Microsoft Edge в фоне"

msgid "Clear the page file at shutdown"
msgstr "Очищать файл подкачки при выключении"

msgid "Wipes virtual memory on shutdown for privacy. Shutdown takes longer."
msgstr "Очищает виртуальную память при выключении ради приватности. Выключение длится дольше."

msgid "Turn off Copilot"
msgstr "Отключить Copilot"

msgid "Turns off Windows Copilot and hides its taskbar button (policy for this user and the PC)."
msgstr "Отключает Windows Copilot и скрывает его кнопку на панели задач (политика для пользователя и ПК)."

msgid "Turn off Recall snapshots"
msgstr "Отключить снимки Recall"

msgid "Stops Recall from saving screenshots of your activity (Copilot+ PCs)."
msgstr "Не даёт Recall сохранять снимки вашей активности (ПК Copilot+)."

msgid "Turn off Click to Do"
msgstr "Отключить Click to Do"

msgid "Disables the AI actions overlay (Win + click) on Copilot+ PCs."
msgstr "Отключает оверлей действий ИИ (Win + щелчок) на ПК Copilot+."

msgid "Turn off AI features in Paint and Notepad"
msgstr "Отключить функции ИИ в Paint и Блокноте"

msgid "Hides Cocreator, Image Creator and generative erase in Paint, and Copilot rewrite in Notepad."
msgstr "Скрывает Cocreator, Image Creator и генеративное удаление в Paint, а также переписывание Copilot в Блокноте."

msgid "Turn off the advertising ID"
msgstr "Отключить рекламный идентификатор"

msgid "Apps can no longer use your advertising ID to show personalized ads."
msgstr "Приложения больше не смогут использовать ваш рекламный идентификатор для персональной рекламы."

msgid "Turn off tips and ads on the lock screen"
msgstr "Отключить советы и рекламу на экране блокировки"

msgid "Removes \"fun facts, tips, tricks and more\" and promoted content from the lock screen."
msgstr "Убирает «интересные факты, советы и прочее» и рекламный контент с экрана блокировки."

msgid "Turn off Start menu recommendations"
msgstr "Отключить рекомендации в меню «Пуск»"

msgid "Stops promoted apps and \"recommended\" tips in the Start menu."
msgstr "Убирает продвигаемые приложения и «рекомендуемые» советы из меню «Пуск»."

msgid "Turn off Copilot and shopping in Microsoft Edge"
msgstr "Отключить Copilot и покупки в Microsoft Edge"

msgid "Hides Edge's sidebar (Copilot), shopping assistant and Microsoft Rewards."
msgstr "Скрывает боковую панель Edge (Copilot), помощника покупок и Microsoft Rewards."

