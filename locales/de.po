msgstr "Öffnet direkt das vollständige klassische Kontextmenü statt des kompakten Windows-11-Menüs."

msgid "Disable ads and suggested apps"
msgstr "Werbung und vorgeschlagene Apps ausschalten"

msgid "Stops Start suggestions, silently installed promoted apps, tips and sync-provider ads in File Explorer."
msgstr "Stoppt Start-Vorschläge, still installierte beworbene Apps, Tipps und Werbung von Synchronisierungsanbietern im Explorer."

msgid "Disable blur on the sign-in screen"
msgstr "Unschärfe auf dem Anmeldebildschirm ausschalten"

msgid "Shows the sign-in background image sharp instead of blurred."
msgstr "Zeigt das Anmeldehintergrundbild scharf statt unscharf."

msgid "Use the classic battery indicator"
msgstr "Klassische Akkuanzeige verwenden"

msgid "Replaces the modern battery flyout with the Windows 7 style one."
msgstr "Ersetzt das moderne Akku-Flyout durch das im Windows-7-Stil."

msgid "Show estimated battery time remaining"
msgstr "Geschätzte Restlaufzeit des Akkus anzeigen"

msgid "Shows remaining battery time in the battery tooltip and flyout."
msgstr "Zeigt die Restlaufzeit in Tooltip und Flyout des Akkus."

msgid "Disable Widgets"
msgstr "Widgets ausschalten"

msgid "Removes the Widgets board and its taskbar button."
msgstr "Entfernt das Widgets-Board und seine Taskleistenschaltfläche."

msgid "Remove the shortcut arrow overlay"
msgstr "Verknüpfungspfeil entfernen"

msgid "Hides the small arrow drawn on shortcut icons."
msgstr "Blendet den kleinen Pfeil auf Verknüpfungssymbolen aus."

msgid "Disable Peek at desktop"
msgstr "Desktopvorschau ausschalten"

msgid "Turns off the desktop preview when hovering the end of the taskbar."
msgstr "Schaltet die Desktopvorschau am Ende der Taskleiste aus."

msgid "Use the classic volume control"
msgstr "Klassische Lautstärkeregelung verwenden"

msgid "Shows the Windows 7 style volume slider from the tray icon."
msgstr "Zeigt den Lautstärkeregler im Windows-7-Stil vom Infobereichssymbol."

msgid "Disable \"You have new apps that can open this type of file\""
msgstr "„Sie haben neue Apps, die diesen Dateityp öffnen können“ ausschalten"

msgid "Stops the prompt that appears after installing an app that handles a file type."
msgstr "Stoppt die Meldung nach der Installation einer App, die einen Dateityp verarbeitet."

msgid "Add \"Command Prompt as Administrator\" to the folder context menu"
msgstr "„Eingabeaufforderung als Administrator“ zum Ordner-Kontextmenü hinzufügen"

msgid "Right-click the background of a folder to open an elevated command prompt there."
msgstr "Rechtsklick auf den Ordnerhintergrund öffnet dort eine Eingabeaufforderung mit Administratorrechten."

msgid "Check \"Do this for all current items\" by default"
msgstr "„Für alle aktuellen Elemente wiederholen“ standardmäßig aktivieren"

msgid "Pre-checks the box in the file conflict dialog."
msgstr "Aktiviert das Kästchen im Dateikonflikt-Dialog vorab."

msgid "Enable inline AutoComplete"
msgstr "Inline-AutoVervollständigen aktivieren"

msgid "Completes typed text in the address bar, Run dialog and Open/Save dialogs."
msgstr "Vervollständigt Text in Adressleiste, Ausführen-Dialog und Öffnen/Speichern-Dialogen."

msgid "Open File Explorer to"
msgstr "Datei-Explorer öffnen in"

msgid "Choose the folder a new File Explorer window starts in."
msgstr "Ordner wählen, in dem ein neues Explorer-Fenster startet."

msgid "This PC"
msgstr "Dieser PC"

msgid "Quick access / Home"
msgstr "Schnellzugriff / Start"

msgid "Downloads"
msgstr "Downloads"

msgid "Disable pop-up descriptions"
msgstr "Popup-Beschreibungen ausschalten"

msgid "Hides the tooltip shown when hovering over files and folders."
msgstr "Blendet den Tooltip beim Überfahren von Dateien und Ordnern aus."

msgid "Show drive letters first"
msgstr "Laufwerksbuchstaben zuerst anzeigen"

msgid "Shows \"(C:) Local Disk\" instead of \"Local Disk (C:)\"."
msgstr "Zeigt „(C:) Lokaler Datenträger“ statt „Lokaler Datenträger (C:)“."

msgid "Show full details in file operation dialogs"
msgstr "Vollständige Details in Dateivorgangsdialogen anzeigen"

msgid "Copy, move and delete dialogs open with \"More details\" expanded."
msgstr "Kopieren-, Verschieben- und Löschen-Dialoge öffnen sich mit aufgeklappten „Weiteren Details“."

msgid "Add Rotate left/right to the image context menu"
msgstr "Links/Rechts drehen zum Bild-Kontextmenü hinzufügen"

msgid "Adds rotate commands for JPEG, PNG and BMP files."
msgstr "Fügt Drehbefehle für JPEG-, PNG- und BMP-Dateien hinzu."

msgid "Use the classic File Explorer ribbon"
msgstr "Klassisches Explorer-Menüband verwenden"

msgid "Restores the Windows 10 tabbed ribbon. Works on early Windows 11 releases only."
msgstr "Stellt das Registerkarten-Menüband von Windows 10 wieder her. Nur bei frühen Windows-11-Versionen."

msgid "Don't add \"- Shortcut\" to new shortcuts"
msgstr "Kein „- Verknüpfung“ an neue Verknüpfungen anhängen"

msgid "New shortcuts keep the original name."
msgstr "Neue Verknüpfungen behalten den ursprünglichen Namen."

msgid "Speed up mouse hover"
msgstr "Mauszeiger-Hover beschleunigen"

msgid "Tooltips and hover previews appear faster (default 400 ms)."
msgstr "Tooltips und Hover-Vorschauen erscheinen schneller (Standard 400 ms)."

msgid "Increase the icon cache"
msgstr "Symbolcache vergrößern"

msgid "Lets Windows keep more icons in memory, so folders and the desktop load faster."
msgstr "Windows behält mehr Symbole im Speicher, sodass Ordner und Desktop schneller laden."

msgid "Disable Bing in taskbar search"
msgstr "Bing in der Taskleistensuche ausschalten"

msgid "Search on the taskbar only looks at your PC, not the web."
msgstr "Die Taskleistensuche durchsucht nur Ihren PC, nicht das Web."

msgid "Add \"End task\" to the taskbar menu"
msgstr "„Task beenden“ zum Taskleistenmenü hinzufügen"

msgid "Right-click a taskbar button to force-close the app."
msgstr "Rechtsklick auf eine Taskleistenschaltfläche schließt die App zwangsweise."

msgid "Align taskbar buttons to the left"
msgstr "Taskleistenschaltflächen links ausrichten"

msgid "Moves the centered Windows 11 taskbar icons to the left."
msgstr "Verschiebt die zentrierten Taskleistensymbole von Windows 11 nach links."

msgid "Show seconds in the taskbar clock"
msgstr "Sekunden in der Taskleistenuhr anzeigen"

msgid "Show the Windows version on the desktop"
msgstr "Windows-Version auf dem Desktop anzeigen"

msgid "Draws the Windows edition and build in the lower-right corner."
msgstr "Zeigt Windows-Edition und Build unten rechts an."

msgid "Disable AutoPlay on all drives"
msgstr "Automatische Wiedergabe auf allen Laufwerken ausschalten"

msgid "Close unresponsive apps automatically"
msgstr "Nicht reagierende Apps automatisch schließen"

msgid "Ends hung apps faster and skips the \"This app is preventing shutdown\" screen."
msgstr "Beendet hängende Apps schneller und überspringt den Bildschirm „Diese App verhindert das Herunterfahren“."

msgid "Never end apps automatically at shutdown"
msgstr "Apps beim Herunterfahren nie automatisch beenden"

msgid "Windows waits for you instead of closing apps with unsaved work."
msgstr "Windows wartet auf Sie, statt Apps mit ungespeicherter Arbeit zu schließen."

msgid "Disable the security warning on downloaded files"
msgstr "Sicherheitswarnung bei heruntergeladenen Dateien ausschalten"

msgid "Downloaded files are no longer marked as coming from the internet."
msgstr "Heruntergeladene Dateien werden nicht mehr als aus dem Internet stammend markiert."

msgid "Add \"Take Ownership\" to the context menu"
msgstr "„Besitz übernehmen“ zum Kontextmenü hinzufügen"

msgid "Right-click a file or folder to give Administrators full access to it."
msgstr "Rechtsklick auf Datei oder Ordner gibt Administratoren Vollzugriff."

msgid "Disable SmartScreen"
msgstr "SmartScreen ausschalten"

msgid "Turns off SmartScreen checks for apps and files."
msgstr "Schaltet SmartScreen-Prüfungen für Apps und Dateien aus."

msgid "Show details on blue screens"
msgstr "Details auf Bluescreens anzeigen"

msgid "Shows the classic stop-error details instead of the sad face."
msgstr "Zeigt die klassischen Stoppfehler-Details statt des traurigen Gesichts."

msgid "Let elevated apps see mapped network drives"
msgstr "Apps mit erhöhten Rechten verbundene Netzlaufwerke sehen lassen"

msgid "Apps run as administrator can access drives mapped by your normal session."
msgstr "Als Administrator ausgeführte Apps können auf Laufwerke Ihrer normalen Sitzung zugreifen."

msgid "Disable User Account Control (UAC)"
msgstr "Benutzerkontensteuerung (UAC) ausschalten"

msgid "Every app runs with full administrator rights and no prompt."
msgstr "Jede App läuft mit vollen Administratorrechten ohne Nachfrage."

msgid "Block potentially unwanted apps (adware) in Defender"
msgstr "Potenziell unerwünschte Apps (Adware) in Defender blockieren"

msgid "Make USB storage read-only"
msgstr "USB-Speicher schreibgeschützt machen"

msgid "Nothing can be written to USB mass storage devices."
msgstr "Auf USB-Massenspeicher kann nichts geschrieben werden."

msgid "Notify when the camera turns on or off"
msgstr "Benachrichtigen, wenn die Kamera ein- oder ausgeschaltet wird"

msgid "Save a crash dump when a program crashes"
msgstr "Absturzabbild speichern, wenn ein Programm abstürzt"

msgid "Writes full dumps to %LOCALAPPDATA%\\CrashDumps (keeps the last 10)."
msgstr "Schreibt vollständige Abbilder nach %LOCALAPPDATA%\\CrashDumps (behält die letzten 10)."

msgid "Allow Windows 11 upgrade on unsupported hardware"
msgstr "Upgrade auf Windows 11 auf nicht unterstützter Hardware erlauben"

msgid "Lets the Windows 11 installer skip the TPM 2.0 and CPU checks."
msgstr "Lässt das Windows-11-Setup die TPM-2.0- und CPU-Prüfungen überspringen."

msgid "Enable Windows Photo Viewer"
msgstr "Windows-Fotoanzeige aktivieren"

msgid "Makes the classic Photo Viewer available in \"Open with\" for common image types."
msgstr "Macht die klassische Fotoanzeige unter „Öffnen mit“ für gängige Bildtypen verfügbar."

msgid "Disable background apps"
msgstr "Hintergrund-Apps ausschalten"

msgid "Store apps can't run in the background, which saves power."
msgstr "Store-Apps können nicht im Hintergrund laufen, das spart Strom."

msgid "Add classic User Accounts to Control Panel"
msgstr "Klassische Benutzerkonten zur Systemsteuerung hinzufügen"

msgid "Adds an entry that opens the advanced user accounts dialog (netplwiz)."
msgstr "Fügt einen Eintrag hinzu, der den erweiterten Benutzerkonten-Dialog (netplwiz) öffnet."

msgid "Use classic Alt+Tab"
msgstr "Klassisches Alt+Tab verwenden"

msgid "Small icons instead of large window previews."
msgstr "Kleine Symbole statt großer Fenstervorschauen."

msgid "Disable driver updates via Windows Update"
msgstr "Treiberupdates über Windows Update ausschalten"

msgid "Disable automatic Store app updates"
msgstr "Automatische Store-App-Updates ausschalten"

msgid "Disable power throttling"
msgstr "Energiedrosselung ausschalten"

msgid "Background apps keep full CPU speed. Uses more battery."
msgstr "Hintergrund-Apps behalten volle CPU-Geschwindigkeit. Verbraucht mehr Akku."

msgid "Minimize telemetry and data collection"
msgstr "Telemetrie und Datenerfassung minimieren"

msgid "Sets diagnostic data to the lowest level the edition allows."
msgstr "Setzt Diagnosedaten auf die niedrigste Stufe, die die Edition erlaubt."

msgid "Stop Microsoft Edge running in the background"
msgstr "Microsoft Edge nicht im Hintergrund laufen lassen"

msgid "Clear the page file at shutdown"
msgstr "Auslagerungsdatei beim Herunterfahren leeren"

msgid "Wipes virtual memory on shutdown for privacy. Shutdown takes longer."
msgstr "Löscht beim Herunterfahren den virtuellen Speicher für den Datenschutz. Das Herunterfahren dauert länger."

msgid "Turn off Copilot"
msgstr "Copilot ausschalten"

msgid "Turns off Windows Copilot and hides its taskbar button (policy for this user and the PC)."
msgstr "Schaltet Windows Copilot aus und blendet seine Taskleistenschaltfläche aus (Richtlinie für diesen Benutzer und den PC)."

msgid "Turn off Recall snapshots"
msgstr "Recall-Momentaufnahmen ausschalten"

msgid "Stops Recall from saving screenshots of your activity (Copilot+ PCs)."
msgstr "Verhindert, dass Recall Screenshots Ihrer Aktivität speichert (Copilot+-PCs)."

msgid "Turn off Click to Do"
msgstr "Click to Do ausschalten"

msgid "Disables the AI actions overlay (Win + click) on Copilot+ PCs."
msgstr "Schaltet das KI-Aktionen-Overlay (Win + Klick) auf Copilot+-PCs aus."

msgid "Turn off AI features in Paint and Notepad"
msgstr "KI-Funktionen in Paint und Editor ausschalten"

msgid "Hides Cocreator, Image Creator and generative erase in Paint, and Copilot rewrite in Notepad."
msgstr "Blendet Cocreator, Image Creator und generatives Löschen in Paint sowie Copilot-Umschreiben im Editor aus."

msgid "Turn off the advertising ID"
msgstr "Werbe-ID ausschalten"

msgid "Apps can no longer use your advertising ID to show personalized ads."
msgstr "Apps können Ihre Werbe-ID nicht mehr für personalisierte Werbung nutzen."

msgid "Turn off tips and ads on the lock screen"
msgstr "Tipps und Werbung auf dem Sperrbildschirm ausschalten"

msgid "Removes \"fun facts, tips, tricks and more\" and promoted content from the lock screen."
msgstr "Entfernt „Wissenswertes, Tipps, Tricks und mehr“ und beworbene Inhalte vom Sperrbildschirm."

msgid "Turn off Start menu recommendations"
msgstr "Empfehlungen im Startmenü ausschalten"

msgid "Stops promoted apps and \"recommended\" tips in the Start menu."
msgstr "Stoppt beworbene Apps und „empfohlene“ Tipps im Startmenü."

msgid "Turn off Copilot and shopping in Microsoft Edge"
msgstr "Copilot und Shopping in Microsoft Edge ausschalten"

msgid "Hides Edge's sidebar (Copilot), shopping assistant and Microsoft Rewards."
msgstr "Blendet die Edge-Seitenleiste (Copilot), den Shopping-Assistenten und Microsoft Rewards aus."

